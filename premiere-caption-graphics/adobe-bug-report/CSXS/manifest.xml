<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal reproduction for an Adobe bug report: CSInterface.evalScript()
  returns the literal "EvalScript error." for app.name — a built-in
  ExtendScript global with zero dependency on any custom script. No
  ScriptPath is declared here on purpose: this extension loads no
  ExtendScript file of its own at all, so the failure cannot be blamed on
  anything this extension defines.
-->
<ExtensionManifest Version="8.0" ExtensionBundleId="com.captionstudio.evalscriptrepro" ExtensionBundleVersion="0.1.0"
  ExtensionBundleName="EvalScript Repro"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.captionstudio.evalscriptrepro.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.0]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.captionstudio.evalscriptrepro.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>EvalScript Repro</Menu>
          <Geometry>
            <Size>
              <Height>160</Height>
              <Width>360</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
