{
  "id": "com.captionstudio.ppro",
  "name": "Caption Graphics Studio",
  "shortname": "captionstudio",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.1.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "id": "captionStudioPanel",
      "type": "panel",
      "minimumSize": { "width": 380, "height": 560 },
      "maximumSize": { "width": 1400, "height": 1600 },
      "preferredDockedSize": { "width": 440, "height": 720 },
      "preferredFloatingSize": { "width": 460, "height": 760 },
      "label": { "default": "Caption Graphics Studio" },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.svg",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
